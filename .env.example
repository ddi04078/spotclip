# OCR-only /api/search needs KAKAO_REST_API_KEY, access token and allowed origins only.
# OPENAI_API_KEY is optional and must remain empty for the free OCR-first phase.
# Server ONLY. Never use EXPO_PUBLIC_ for credentials or the access token.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
KAKAO_REST_API_KEY=
# Generate a unique random 32+ character token. Enter in client at runtime, never bundle.
SPOTCLIP_ACCESS_TOKEN=
SPOTCLIP_ALLOWED_ORIGINS=https://ddi04078.github.io
PORT=8787

# Optional deployment verification CLI only (not bundled into app).
SPOTCLIP_SEARCH_ENDPOINT=
