{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "noEmit": true,
    "types": [
      "react",
      "node",
      "jest"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "scripts/html-preview/**/*.ts",
    "scripts/html-preview/**/*.tsx"
  ]
}
