{
  "name": "spotclip",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "scripts": {
    "start": "expo start --go --max-workers 2",
    "dev": "expo start --go --max-workers 2",
    "ios": "expo start --go --ios --max-workers 2",
    "android": "expo start --go --android --max-workers 2",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:ui": "jest --runInBand",
    "build": "expo export --platform ios --platform android --output-dir dist --max-workers 2",
    "web": "expo start --web --max-workers 2 --port 8082",
    "build:web": "expo export --platform web --output-dir dist-web --max-workers 2",
    "test:web": "playwright test --config playwright.config.ts",
    "preview:pc": "node scripts/pc-preview.mjs",
    "build:html": "node scripts/build-html-preview.mjs",
    "test:html": "playwright test --config playwright.html.config.ts",
    "server": "node --env-file=.env server/start.mjs",
    "dev:client": "expo start --dev-client --max-workers 2",
    "ios:device": "expo run:ios --device"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.29",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-modules-core": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.2.3",
    "@types/react-dom": "~19.2.2"
  }
}
